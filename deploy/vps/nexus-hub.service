# Nexus-Hub on the VPS (Oracle Linux 9). Installed to
# /etc/systemd/system/nexus-hub.service; see deploy/vps/README.md.
# /etc/nexus-hub/env holds DATABASE_URL and NEXUS_MASTER_KEY_FILE.
# Releases are switched by /opt/nexus-hub/bin/deploy.sh through the
# /opt/nexus-hub/current symlink.
[Unit]
Description=Nexus-Hub ClickUp/GitHub/Telegram agent hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexus
Group=nexus
EnvironmentFile=/etc/nexus-hub/env
Environment=GOMEMLIMIT=300MiB
ExecStart=/opt/nexus-hub/current/nexus-server
WorkingDirectory=/var/lib/nexus-hub
Restart=always
RestartSec=5
# Phase 12 graceful shutdown: SIGTERM only the hub process so a draining
# step's git/CLI children are not killed under it; shutdown_timeout (max
# 80s) plus the stop grace stays below TimeoutStopSec.
KillMode=mixed
TimeoutStopSec=100

# repos_dir and tmp_dir default to /var/lib/nexus-hub/{repos,tmp}.
StateDirectory=nexus-hub
StateDirectoryMode=0700

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nexus-hub
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
CapabilityBoundingSet=
# Unprivileged bwrap needs mount operations and user/mount/process/network
# namespaces; AF_NETLINK lets it set up loopback in the new network namespace.
# It still receives no capabilities from the service.
SystemCallFilter=@system-service @mount
RestrictNamespaces=user mnt pid net ipc uts cgroup

MemoryMax=400M
TasksMax=64

[Install]
WantedBy=multi-user.target
