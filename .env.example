# Server
PORT=8080
BODY_LIMIT=1M
SHUTDOWN_TIMEOUT=10s

# Relay / debounce
DEBOUNCE_WINDOW=8s
DEBOUNCE_MAX_WAIT=30s

# ClickUp: secret dùng để verify header X-Signature (để trống = tắt verify, chỉ dùng cho dev)
CLICKUP_WEBHOOK_SECRET=

# LLM
LLM_DEFAULT_PROVIDER=anthropic
LLM_TIMEOUT=60s
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_BASE_URL=
