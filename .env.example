# Nexus-Hub reads exactly two environment variables. Everything else
# (listen address, models, budgets, timeouts, switches) is in app_settings,
# and every secret is an encrypted row in credentials. See
# docs/runbooks/clickup-telegram-local.md, "Phase 2".

# PostgreSQL connection string; never commit credentials.
DATABASE_URL=

# Absolute path to the 32-byte master key (mode 0600), created with
#   setup-notices master-key init --path <file>
NEXUS_MASTER_KEY_FILE=

# Legacy (Phase 1) only: values for *_env references until you run
#   setup-notices migrate-secrets --workspace-id <uuid>
# NEXUS_CLICKUP_WEBHOOK_SECRET=
# NEXUS_TELEGRAM_BOT_TOKEN=
