# Server
PORT=8080
BODY_LIMIT=1M
SHUTDOWN_TIMEOUT=10s

# PostgreSQL: explicit local development connection string; never commit credentials.
DATABASE_URL=

# Durable ClickUp -> Telegram notices
NOTICE_POLL_INTERVAL=1s
NOTICE_REQUEST_TIMEOUT=10s
# Secret values referenced by integration.config, not integration/workspace IDs.
NEXUS_CLICKUP_WEBHOOK_SECRET=
NEXUS_TELEGRAM_BOT_TOKEN=

# Relay / debounce
# Reserved for future AI batching; notices bypass debounce.
DEBOUNCE_WINDOW=8s
DEBOUNCE_MAX_WAIT=30s

PUBLIC_BASE_URL=
# ClickUp API credential for manual webhook registration; NOT the webhook HMAC secret.
# Inbound signature verification is mandatory, including local tunnel mode.
CLICKUP_API=

# LLM: unused by Phase 1 notices.
LLM_DEFAULT_PROVIDER=anthropic
LLM_TIMEOUT=60s
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_BASE_URL=
